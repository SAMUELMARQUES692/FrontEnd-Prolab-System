# URLs de produção (Render) — copie estes valores para as
# Environment Variables do projeto na Vercel (Project Settings > Environment Variables).
# Não é preciso criar um arquivo .env.production local: a Vercel injeta essas
# variáveis no build a partir do próprio painel.

VITE_AUTH_API_URL=https://SEU-AUTH-SERVICE.onrender.com
VITE_PROLAB_API_URL=https://SEU-PROLAB-SYSTEM.onrender.com
